# 监控大屏本地开发配置 —— 复制为 .env 后按需修改，换机器只改这一个文件
# 后端监听地址/端口
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002
# 前端 Vite 端口
FRONTEND_PORT=5180
# 前端请求后端的接口前缀（默认 /api，开发模式由 Vite 代理到 BACKEND_HOST:BACKEND_PORT）
VITE_API_BASE_URL=/api
# 允许跨域访问后端的来源（留空则自动放行本机 FRONTEND_PORT）
CORS_ORIGINS=
# 示例/运行态数据目录（默认 backend/data，可不改）
# DATA_DIR=/workspace/backend/data
