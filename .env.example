# ============================================================
# 本地开发统一配置 —— 复制为 .env 后按需修改，换机器只改这里
# 用法: cp .env.example .env
# scripts/dev.sh 启动时会自动加载本目录下的 .env
# ============================================================

# 后端 FastAPI 监听端口
BACKEND_PORT=8002

# 前端 Vite dev server 监听端口
FRONTEND_PORT=5180

# 前端把 /api 代理到的后端地址（必须与 BACKEND_PORT 对应）
VITE_API_PROXY_TARGET=http://localhost:8002

# 启动后是否自动打开浏览器 (true/false)
BROWSER_OPEN=false
